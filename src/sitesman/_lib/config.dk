#include "dkli.dkh"
#!
module "config"
{
    if not(isset("@http_context")) { ref @http_context = @@(@crud_context,"&http") }

    //* ======================================== [ _PACKAGE ]
    @SITEMAN_DRVMAN = "/!/sitesman/drvman/"
    @SITEMAN_EXPLORE = "/!/sitesman/drvman/go/explore/"

    //* ======================================== [ _STATIC RESOURCES ]
    @CSS_DRVMAN = "/$/sitesman/css/drvman.css"
    @JS_DRVMAN = "/$/sitesman/js/drvman.js"
    @IMG_DRVMAN_APP = "/$/sitesman/img/icons/web-app.png"
    @IMG_DRVMAN_CONTENT = "/$/sitesman/img/icons/web-site.png"

    //* ======================================== [ AUTHORIZATIONS ]
    @STM_AUT_ACCESS = "STM-00-00-000"
    @STM_AUT_READONLY = "STM-00-00-001"
    @STM_AUT_ACCESS_SITES = "STM-00-00-002"
    @STM_AUT_ACCESS_PROPERTIES = "STM-00-00-003"

    //* ======================================== [ ... ]
    @dklfso_privs_ext="._p_"    // Extensión para archivos de privilegios
}