#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
	#include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"

    do @context.begin(@crud_context)

    ref unidades = @("&./")
    ref get = @@(@http_context,"&request/get")

    print_actions::
    {
        @btn_class = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"
        #$ a(href="#<@FILES_DRVMAN>/_new/" class="#<@btn_class>"){$"Crear unidad"}
    }

    #! point actions to print_actions

    new v12_form_bar_cfg
    {
        @"title": "Unidades de almacenamiento"
        @"buttons*": actions
        @"urlexit": "/"
        member @"hidden" { @"print": @true }
    }

    #$ div
    {
        link(href="#<@CSS_DRVMAN>" rel="stylesheet")
        
        div(class="container-fluid p-0")
        {
            #! do uie.printV12FormBar(v12_form_bar_cfg)

            #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
            {
                p{$"#<@('$error/message')>"}

                div(class="row m-0 p-4")
                {
                    #! for i = 0; i < list.count(unidades)
                    {
                        ref unidad = list.obj(unidades, i)
                        unidad_pk = @@(unidad, "#sys_pk")
                        
                        #$ div(class="col-12 col-sm-6 col-md-3 col-lg-2 p-2")
                        {
                            div(class="d-flex align-items-center justify-content-center border unit-container")
                            {
                                div(class="dropdown unit-options-container")
                                {
                                    button(class="btn btn-sm shadow-none" type="button" id="dropdownMenuButton1" "data-bs-toggle"="dropdown"){
                                        $"#<@ICON_THREE_DOTS_VERTICAL>"
                                    }
                                    ul(class="dropdown-menu rounded-0 shadow-sm" "aria-labelledby"="dropdownMenuButton1")
                                    {
                                        li{a(class="dropdown-item" href="#<@FILES_DRVMAN>/#<unidad_pk>/"){$"Editar"}}
                                        li{a(class="dropdown-item" href="#" onclick="drvman.deleteUnit(#<unidad_pk>)"){$"Eliminar"}}
                                        li{a(class="dropdown-item" href="#"){$"Abrir explorador"}}
                                    }
                                }
                                small{$"#<@@(unidad,'fsname')>"}
                            }
                        }
                    }
                }
            }
        }

        script(src="#<@JS_DRVMAN>"){$""}
        script{$'
            drvman.units = #<to.json(unidades)>;
        '}
    }
}