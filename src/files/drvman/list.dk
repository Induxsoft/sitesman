#include "dkli.dkh"
#!
module "list"
{
    #include "functions.dkh"
	#include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"

    do @context.begin(@crud_context)

    ref unidades = @("&./")
    ref get = @@(@http_context,"&request/get")

    print_actions::
    {
        @btn_class = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"
        #$
        a(href="#<@FILES_DRVMAN>/_new/" class="#<@btn_class>"){$"Crear"}
        button(class="#<@btn_class>" onclick=""){$"Editar"}
        button(class="#<@btn_class>" onclick=""){$"Eliminar"}
        button(class="#<@btn_class>" onclick=""){$"Abrir Explorador"}
    }

    #! point actions to print_actions

    new v12_form_bar_cfg
    {
        @"title": "Unidades de almacenamiento"
        @"buttons*": actions
        @"urlexit": "/"
        member @"hidden" { @"print": @true }
    }

    #$ div
    {
        div(class="container-fluid p-0")
        {
            #! do uie.printV12FormBar(v12_form_bar_cfg)

            #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
            {
                p{$"#<@('$error/message')>"}

                div(class="row m-0 p-4")
                {
                    #! for i = 0; i < list.count(unidades)
                    {
                        ref unidad = list.obj(unidades, i)
                        
                        #$ div(class="col-12 col-sm-6 col-md-3 col-lg-2 p-2")
                        {
                            div(class="d-flex align-items-center justify-content-center border shadow-sm" style="min-height: 10rem; cursor:pointer;")
                            {
                                small{$"#<@@(unidad,'fsname')>"}
                            }
                        }
                    }
                }
            }
        }
    }
}