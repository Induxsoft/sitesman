#include "dkli.dkh"
#!
module "form"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"

    do @context.begin(@crud_context)
    
    ref unidad = @("&./unidad")
    ref ugroup = @("&./ugroup")
    ref get = @@(@http_context,"&request/get")

    new def_usergroup
    {
        @"datatable*": ugroup
        member "attributes"
        {
            @"class":"induxsoft-form-select"
            @"name":"admins"
        }
        @"text_field":"description"
        @"value_field":"sys_pk"
        @"selected":@@(unidad,'admins')
    }

    isNew = (@@(get,"$_entity_id") == "_new")

    #$ div(class="container p-0")
    {
        form(action="." method="POST")
        {
            div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
            {
                div(class="col-4 d-flex align-items-center p-0")
                {
                    h5(class="tex-no-break m-0"){$"#<ifstr(isNew,'Agregar','Editar')> unidad"}
                }
                div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2" id="main_bar_controls")
                {
                    a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                    button(type="submit" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"#<@ICON_SAVE>"}
                    a(href="../" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"#<@ICON_X_LG>"}
                }
            }
            div(id="work_area" class="container-section")
            {
                input(type="hidden" name="sys_recver" value="#<@@(unidad,'sys_recver')>")

                div(class="#<ifstr(@('error/message')!='','alert alert-danger','')>"){$"#<@('error/message')>"}
                div(class="row")
                {
                    div(class="col-12 col-sm-6")
                    {
                        small(class="fw-bold"){"Nombre:"}
                        input(class="induxsoft-form-control" type="text" name="fsname" value="#<@@(unidad,'fsname')>" maxlength="50" required="")
                    }
                    div(class="col-12 col-sm-6")       
                    {
                        small(class="fw-bold"){"Ruta:"}
                        input(class="induxsoft-form-control" type="text" name="path" value="#<@@(unidad,'path')>" maxlength="1024" required="")
                    }
                    div(class="col-12 col-sm-6")       
                    {
                        small(class="fw-bold"){"Grupo de administradores:"}
                        #! do uie.dbSelect(def_usergroup)
                    }
                }
            }
        }
    }
}